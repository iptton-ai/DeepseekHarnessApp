{
  "module": "questions.schema.js",
  "dshVersion": "0.1.0-rc.6",
  "schemas": {
    "askUserQuestionAnswerSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "selected": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "custom": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "selected"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "answers"
      ],
      "additionalProperties": false
    },
    "questionResponsePayloadSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "object",
          "properties": {
            "answers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "selected": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "custom": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "selected"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "answers"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sessionId",
        "answer"
      ],
      "additionalProperties": false
    }
  }
}
