{
  "module": "jobs.schema.js",
  "dshVersion": "0.1.0-rc.6",
  "schemas": {
    "taskIdSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "minLength": 1
    },
    "taskViewSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "const": "running"
            },
            {
              "type": "string",
              "const": "stopping"
            },
            {
              "type": "string",
              "const": "completed"
            },
            {
              "type": "string",
              "const": "killed"
            },
            {
              "type": "string",
              "const": "failed"
            }
          ]
        },
        "detail": {
          "type": "string"
        },
        "startedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finishedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "status",
        "startedAt"
      ],
      "additionalProperties": false
    }
  }
}
