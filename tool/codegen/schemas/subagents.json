{
  "module": "subagents.schema.js",
  "dshVersion": "0.1.0-rc.6",
  "schemas": {
    "subagentHistoryRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "parentSessionId": {
          "type": "string",
          "minLength": 1
        },
        "childSessionId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "const": "one-shot"
            },
            {
              "type": "string",
              "const": "continuable"
            }
          ]
        },
        "beforeSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxMessages": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "parentSessionId",
        "childSessionId",
        "mode"
      ],
      "additionalProperties": false
    },
    "subagentHistoryValueSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "seq": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "time": {
                    "type": "number"
                  },
                  "data": {},
                  "sourceEventSeqs": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "surfaceOp": {},
                  "ignorable": {
                    "type": "boolean",
                    "const": true
                  }
                },
                "required": [
                  "type",
                  "seq",
                  "time",
                  "data"
                ],
                "additionalProperties": false
              },
              "view": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "for": {
                        "type": "string",
                        "const": "call"
                      },
                      "view": {
                        "type": "object",
                        "properties": {
                          "card": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "card"
                        ],
                        "additionalProperties": {}
                      }
                    },
                    "required": [
                      "for",
                      "view"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "for": {
                        "type": "string",
                        "const": "result"
                      },
                      "view": {
                        "type": "object",
                        "properties": {
                          "card": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "card"
                        ],
                        "additionalProperties": {}
                      }
                    },
                    "required": [
                      "for",
                      "view"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "event"
            ],
            "additionalProperties": false
          }
        },
        "hasMore": {
          "type": "boolean"
        },
        "projections": {
          "type": "object",
          "properties": {
            "asOfSeq": {
              "type": "integer",
              "minimum": -1,
              "maximum": 9007199254740991
            },
            "values": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "asOfSeq",
            "values"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "events",
        "hasMore"
      ],
      "additionalProperties": false
    },
    "subagentInterruptRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "parentSessionId": {
          "type": "string",
          "minLength": 1
        },
        "childSessionId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "const": "continuable"
        }
      },
      "required": [
        "parentSessionId",
        "childSessionId",
        "mode"
      ],
      "additionalProperties": false
    },
    "subagentInterruptValueSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "accepted"
      ],
      "additionalProperties": false
    },
    "subagentListEntrySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "child"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "type": "string",
              "const": "one-shot"
            },
            "activity": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "running"
                },
                {
                  "type": "string",
                  "const": "inactive"
                }
              ]
            },
            "hasChildren": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "mode",
            "activity",
            "hasChildren"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "child"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "type": "string",
              "const": "continuable"
            },
            "activity": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "running"
                },
                {
                  "type": "string",
                  "const": "inactive"
                }
              ]
            },
            "hasChildren": {
              "type": "boolean"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "mode",
            "activity",
            "hasChildren",
            "label"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "diagnostic"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "corrupt"
                },
                {
                  "type": "string",
                  "const": "unsupported"
                },
                {
                  "type": "string",
                  "const": "unavailable"
                }
              ]
            }
          },
          "required": [
            "kind",
            "id",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "subagentListRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "parentSessionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "parentSessionId"
      ],
      "additionalProperties": false
    },
    "subagentListValueSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "child"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "type": "string",
                    "const": "one-shot"
                  },
                  "activity": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "running"
                      },
                      {
                        "type": "string",
                        "const": "inactive"
                      }
                    ]
                  },
                  "hasChildren": {
                    "type": "boolean"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "mode",
                  "activity",
                  "hasChildren"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "child"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "type": "string",
                    "const": "continuable"
                  },
                  "activity": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "running"
                      },
                      {
                        "type": "string",
                        "const": "inactive"
                      }
                    ]
                  },
                  "hasChildren": {
                    "type": "boolean"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "mode",
                  "activity",
                  "hasChildren",
                  "label"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "diagnostic"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "corrupt"
                      },
                      {
                        "type": "string",
                        "const": "unsupported"
                      },
                      {
                        "type": "string",
                        "const": "unavailable"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "parentAvailable": {
          "type": "boolean"
        }
      },
      "required": [
        "entries",
        "parentAvailable"
      ],
      "additionalProperties": false
    },
    "subagentPromptRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "parentSessionId": {
          "type": "string",
          "minLength": 1
        },
        "childSessionId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "const": "continuable"
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": {}
          }
        },
        "clientTimeZone": {
          "type": "string"
        }
      },
      "required": [
        "parentSessionId",
        "childSessionId",
        "mode",
        "content"
      ],
      "additionalProperties": false
    },
    "subagentPromptValueSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string"
        }
      },
      "required": [
        "messageId"
      ],
      "additionalProperties": false
    }
  }
}
